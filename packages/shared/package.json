{
  "name": "@codestreak/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants, env validation, verification rules and the typed CodeStreak program client.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verification": {
      "types": "./dist/verification/index.d.ts",
      "default": "./dist/verification/index.js"
    },
    "./program": {
      "types": "./dist/program/index.d.ts",
      "default": "./dist/program/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "default": "./dist/wallet/index.js"
    },
    "./relayer": {
      "types": "./dist/relayer/index.d.ts",
      "default": "./dist/relayer/index.js"
    },
    "./errors": {
      "types": "./dist/program/errors.d.ts",
      "default": "./dist/program/errors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@solana/web3.js": "^1.98.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
