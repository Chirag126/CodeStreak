{
  "name": "@codestreak/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants, env validation and verification rules for CodeStreak.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verification": {
      "types": "./dist/verification/index.d.ts",
      "default": "./dist/verification/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
