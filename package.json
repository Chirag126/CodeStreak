{
  "name": "codestreak",
  "version": "0.1.0",
  "private": true,
  "description": "CodeStreak: on-chain coding accountability arena on Solana devnet.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "dev:web": "pnpm --filter @codestreak/shared build && pnpm --filter @codestreak/web dev",
    "dev:worker": "pnpm --filter @codestreak/shared build && pnpm --filter @codestreak/worker dev",
    "devnet:init-config": "pnpm --filter @codestreak/shared build && pnpm --filter @codestreak/devnet-tools init-config",
    "devnet:seed-demo": "pnpm --filter @codestreak/shared build && pnpm --filter @codestreak/devnet-tools seed-demo",
    "devnet:close-challenges": "pnpm --filter @codestreak/shared build && pnpm --filter @codestreak/devnet-tools close-challenges",
    "sync:idl": "node scripts/sync-idl.mjs",
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @codestreak/shared build && pnpm -r run typecheck",
    "lint": "eslint . && pnpm --filter @codestreak/web lint",
    "test": "pnpm test:tooling && pnpm test:spikes && pnpm -r --if-present run test",
    "test:tooling": "node --test \"scripts/*.test.mjs\"",
    "test:spikes": "node --test \"spikes/lib/*.test.mjs\"",
    "check": "pnpm check:secrets && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:github": "pnpm --filter @codestreak/shared build && pnpm --filter @codestreak/worker verify:github"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
