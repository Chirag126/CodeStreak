# =====================================================================
# CodeStreak environment template
# ---------------------------------------------------------------------
# Copy to .env.local (gitignored) and fill in:
#   PowerShell:  Copy-Item .env.example .env.local
#   WSL/bash:    cp .env.example .env.local
#
# Then validate:  pnpm check:env        (or: node scripts/check-env.mjs)
#
# Rules
#   * NEXT_PUBLIC_* values are shipped to the browser. Never put secrets there.
#   * Secret values in THIS file must stay empty. The pre-commit hook enforces it.
#   * CodeStreak runs on Solana DEVNET only. Mainnet URLs are rejected.
#   * "Phase N" = the roadmap phase where the variable becomes required.
# =====================================================================

# ---------------------------------------------------------------------
# Solana network (Phase 1)
# ---------------------------------------------------------------------
SOLANA_CLUSTER=devnet
# Public devnet RPC works for now but is rate-limited.
# Replace with a Helius devnet URL before Phase 9 (deploy).
SOLANA_RPC_URL=https://api.devnet.solana.com

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Devnet token mints. USDC = Circle's devnet USDC (confirm on faucet.circle.com).
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_WSOL_MINT=So11111111111111111111111111111111111111112

# ---------------------------------------------------------------------
# Public keys of the four CodeStreak operator keypairs (Phase 1)
# Generated in WSL by:  bash scripts/wsl/generate-keys.sh
# Copy the values from ~/.config/codestreak/keys/pubkeys.env
# Public keys are not secret.
# ---------------------------------------------------------------------
UPGRADE_AUTHORITY_PUBKEY=
RELAYER_PUBKEY=
VERIFIER_PUBKEY=
ADMIN_PUBKEY=

# ---------------------------------------------------------------------
# Supabase (Phase 1: create the project now)
# Dashboard -> Project Settings -> API Keys
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon JWT. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role JWT. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# GitHub (Phase 1)
# OAuth App client ID/secret go into Supabase Auth -> Providers -> GitHub,
# not into this file.
# This token is used by the verification worker to read PUBLIC repository
# data. Fine-grained PAT, "Public repositories (read-only)", no other scopes.
# ---------------------------------------------------------------------
GITHUB_API_TOKEN=

# ---------------------------------------------------------------------
# Firecrawl (Phase 1) - firecrawl.dev dashboard -> API Keys
# ---------------------------------------------------------------------
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------
APP_URL=http://localhost:3000
# Phase 14: Render worker web service URL
WORKER_URL=

# ---------------------------------------------------------------------
# Program (Phase 9)
# ---------------------------------------------------------------------
NEXT_PUBLIC_CODESTREAK_PROGRAM_ID=

# ---------------------------------------------------------------------
# Signing keys (secret). Locally: absolute path to the keypair JSON.
# On Render: set *_KEYPAIR_JSON to the JSON array instead of a path.
#   relayer  -> web service only    (Phase 15)
#   verifier -> worker service only (Phase 28)
# Windows path to a WSL file example:
#   \\wsl$\Ubuntu\home\<you>\.config\codestreak\keys\relayer.json
# ---------------------------------------------------------------------
RELAYER_KEYPAIR_PATH=
VERIFIER_KEYPAIR_PATH=

# ---------------------------------------------------------------------
# Shared secret for Supabase pg_cron -> worker job endpoints (Phase 14)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------
WORKER_JOB_SECRET=

# ---------------------------------------------------------------------
# ElevenLabs (Phase 33)
# ---------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
